{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "electron-vite/node"
    ],
    "paths": {
      "@nucleo/*": [
        "./src/nucleo/*"
      ]
    }
  },
  "include": [
    "electron.vite.config.mts",
    "vitest.config.mts",
    "playwright.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/nucleo/**/*",
    "tests/**/*",
    "src/renderer/src/leitor/estiloDoLivro.ts"
  ]
}
